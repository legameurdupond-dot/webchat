PORT=3000
JWT_SECRET=change_this_secret_in_production

# Optionnel : serveur TURN (nécessaire pour les connexions derrière NAT/firewall
# strict quand l'app est déployée sur Internet). Ex avec coturn :
# TURN_URL=turn:turn.mondomaine.com:3478
# TURN_USERNAME=webchat
# TURN_CREDENTIAL=change_this_turn_secret

# Alternative recommandée : TURN gratuit via Open Relay (metered.ca), utile
# quand les appelants sont derrière des NAT/box différents (cas courant).
# METERED_APP_NAME=tonappname
# METERED_API_KEY=

# Optionnel : clé API Giphy (https://developers.giphy.com/) pour le sélecteur
# de GIF (avatar/bannière). Sans clé, une clé publique de démo Giphy est
# utilisée (limitée en débit, à ne pas garder en production).
# GIPHY_API_KEY=
